{
  "name": "bluebirds-secure-browser",
  "version": "1.1.12",
  "description": "Lockdown Browser Shell for Bluebirds Assessment Platform",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "start:dev": "npm run build && electron . --dev",
    "watch": "tsc --watch",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win:x64": "npm run build && electron-builder --win --x64",
    "dist:win:ia32": "npm run build && electron-builder --win --ia32 \"-c.win.target=nsis\" -c.win.artifactName=\"BluebirdsSecureBrowser-Setup-x86.exe\"",
    "dist:all": "npm run dist:mac && npm run dist:win:x64 && npm run dist:win:ia32",
    "upload": "node upload.js",
    "publish:r2": "npm run dist && npm run upload",
    "sign:win": "powershell -ExecutionPolicy Bypass -File scripts/sign.ps1"
  },
  "keywords": [],
  "author": "Bluebirds Solutions",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@types/node": "^22.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.bluebirdssolutions.securebrowser",
    "productName": "BluebirdsSecureBrowser",
    "protocols": [
      {
        "name": "Bluebirds Secure Browser",
        "schemes": [
          "bluebirds-sb"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-1e9e8b8aa616426f91b8cc703c2bc2fa.r2.dev/"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/overlay.html",
      "src/splash.html",
      "src/desktop_icon.png",
      "desktop_icon.png",
      "scripts/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "icon": "desktop_icon.png",
      "artifactName": "BluebirdsSecureBrowser.dmg",
      "extendInfo": {
        "NSCameraUsageDescription": "Camera access is required for proctoring and identity verification during the exam.",
        "NSMicrophoneUsageDescription": "Microphone access is required for proctoring and audio analysis during the exam.",
        "NSScreenCaptureUsageDescription": "Screen recording is required to monitor your display during the exam."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop_icon_256x256.ico",
      "artifactName": "BluebirdsSecureBrowser-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Bluebirds Secure Browser",
      "runAfterFinish": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
